import java.util.*;
public class SearchingElement {

// -----> Find out Maximum wealth of one merchant----------

static int maxwealthcalc(int[][] arr){
//    int max=0;
    int max=Integer.MAX_VALUE;
    for (int i=0;i<arr.length;i++) {
        int sum =0;
        for(int j=0;j<i;j++){
            sum +=arr[i][j];
        }
//        max= Math.max(sum,max);
        if(sum>max){
            max=sum;
        }
    }

return max;
}

public static void main(String[] args) {
        int[][] arr={{5,8,10},{6,3,15},{1,2,3}};
        System.out.println(Arrays.toString(arr));
        System.out.println(maxwealthcalc(arr));
    }
}



