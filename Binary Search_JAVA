import java.util.*;
public class SearchingElement {

//   Binary Searching

    static int binarysearch(int[] arr,int t){
        int l=0;
        int h=arr.length-1;
        int mid;
        while(l<=h){
            mid=l+(h+1)/2;
            if(arr[mid]==t){
                return mid;
            }
            if(t>arr[mid]){
                l=mid-1;
            }
            else if (t<arr[mid]){
                h=mid+1;
            }
        }
        return 0;
    }


    public static void main(String[] args) {
        Scanner sc= new Scanner(System.in);
        int n=sc.nextInt();
        int[] arr = {5,10,3,23,12,4};


        System.out.println(binarysearch(arr,n));
    }
}



